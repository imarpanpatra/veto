{
  "manifest_version": 3,
  "name": "The Veto",
  "version": "0.1.0",
  "description": "A local open-weight model whose only job is to stop you.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:4777/*"],
  "action": { "default_popup": "popup.html", "default_title": "The Veto" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
